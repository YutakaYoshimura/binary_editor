<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Sample03_HexEditorWpf</AssemblyName>
    <RootNamespace>HexEditorSample</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- HexEditor.Wpf は WPFHexaEditor と同一コードベースの別パッケージ -->
    <PackageReference Include="HexEditor.Wpf" Version="2.1.8" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SampleHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\samples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>samples\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
