<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Sample08_ByteViewer</AssemblyName>
    <RootNamespace>HexEditorSample</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- NuGetパッケージ不要: System.Design アセンブリに内包 -->
  <ItemGroup>
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SampleHelper.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\samples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>samples\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
</Project>
